# ==============================================================================
# AI Crop Platform - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file containing real API keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Used when building React Vite app on Netlify)
# ------------------------------------------------------------------------------
# Set this in Netlify Environment Variables to point to your Render backend:
# Example: https://ai-crop-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API (Required for AI Agronomist & Diagnostic Advisory)
# Obtain your free Gemini API key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Groq AI API (Optional fast fallback for LLM inference)
# Obtain from: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 4. OpenWeatherMap API (Optional custom weather provider)
# Obtain from: https://openweathermap.org/api
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 5. MongoDB Database Persistence
# Free MongoDB Atlas cluster URI: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicrop_db

# ------------------------------------------------------------------------------
# 6. Backend Server & Security
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8000
DEBUG=True
JWT_SECRET=change_this_to_a_random_secure_secret_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.netlify.app

# ----------------------------------------------------------------------------
# 7. Optional email verification (registration remains usable when disabled)
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ==============================================================================
# AI Crop Platform - Production .gitignore (Zero Secrets & Leak Prevention)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.test
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
credentials.json
client_secret*.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.tern-port
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Python & Machine Learning Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Testing / Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/

# Jupyter / ML Notebooks Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 4. Databases & Storage Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql
*.tar.gz
data/*.sqlite
data/*.db

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & AI Assistants
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.gemini/
.agents/

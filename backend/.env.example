# ==============================================================================
# AI Crop FastAPI Backend - Environment Variables Template
# Set these variables in the Render Dashboard under "Environment Variables".
# ==============================================================================

# Application Settings
APP_NAME=AICrop-FastAPI-Backend
APP_ENV=production
PORT=8000
DEBUG=False

# Security & JWT Token Generation
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Cloud Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aicrop_db

# External AI & Weather APIs
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CORS Configuration (Allowed frontend domains - comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.netlify.app
